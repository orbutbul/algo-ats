# Copy to airflow/.env and fill in. Already covered by the repo's .gitignore (*.env).
#
# IMPORTANT: this path is read by docker-py running *inside* the scheduler
# container, talking to the Docker Desktop daemon over the mounted socket —
# it is NOT the Windows-native docker CLI, so Docker Desktop's automatic
# C:\ -> VM path translation does not apply here. Use the VM-visible path:
# lowercase drive letter, forward slashes, under /run/desktop/mnt/host/<drive>/...
ATS_REPO_HOST_PATH=/run/desktop/mnt/host/c/Users/Or/Downloads/VSCode/ATS_trading
