# Copy to .env and fill in real values. Never commit .env itself (it's gitignored).
# Loaded into the Airflow containers via env_file: ../.env in airflow/docker-compose.yaml.

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
REDDIT_USERNAME=
REDDIT_PASSWORD=
DATABENTO_API_KEY=
MASSIVE_API_KEY=
BENZINGA_API_KEY=
EMAIL=

# ntfy.sh topic used by validation.py::send_alert for push notifications.
# Anyone with this topic name can post/read on it -- treat it as semi-secret.
NTFY_TOPIC=

# Local (non-Docker) runs only -- Airflow containers override this in-place
# to /opt/airflow/project/.credentials.json (see airflow/docker-compose.yaml).
# Windows: C:\Users\<you>\.claude\.credentials.json
# Linux (e.g. running scripts directly on a cloud VM outside Docker): /home/<user>/.claude/.credentials.json
CLAUDE_CREDENTIALS_PATH=
